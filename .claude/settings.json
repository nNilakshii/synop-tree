{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Edit(./.env)",
      "Bash(cat .env)",
      "Bash(cat ./.env)"
    ],
    "allow": [
      "Bash(uv run *)",
      "Bash(make *)",
      "Bash(docker compose *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git log)",
      "Bash(git show *)",
      "Bash(git branch)"
    ]
  }
}
